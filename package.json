{
  "name": "@khelbenlaforge/quartz-crawl-links",
  "version": "1.0.0",
  "description": "Fork of @quartz-community/crawl-links with a case-insensitive shortest-path link match, fixing a real @quartz-community/utils version-drift bug for the Rifted Quartz site",
  "type": "module",
  "license": "MIT",
  "author": "khelbenlaforge",
  "homepage": "https://github.com/khelbenlaforge/quartz-crawl-links",
  "repository": {
    "type": "git",
    "url": "https://github.com/khelbenlaforge/quartz-crawl-links"
  },
  "keywords": ["quartz", "quartz-plugin", "crawl-links", "links", "hast"],
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": { "optional": false }
  },
  "dependencies": {
    "@quartz-community/types": "^0.2.1",
    "@quartz-community/utils": "^0.1.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/node": "^24.10.0",
    "hast": "^1.0.0",
    "is-absolute-url": "^4.0.1",
    "preact": "^10.28.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "crawl-links",
    "displayName": "Crawl Links",
    "category": "transformer",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 60,
    "defaultEnabled": true,
    "defaultOptions": {
      "markdownLinkResolution": "absolute",
      "prettyLinks": true,
      "openLinksInNewTab": false,
      "lazyLoad": false,
      "externalLinkIcon": true,
      "disableBrokenWikilinks": false
    },
    "optionSchema": {
      "markdownLinkResolution": {
        "type": "enum",
        "values": ["shortest", "absolute", "relative"]
      },
      "prettyLinks": { "type": "boolean" },
      "openLinksInNewTab": { "type": "boolean" },
      "lazyLoad": { "type": "boolean" },
      "externalLinkIcon": { "type": "boolean" },
      "disableBrokenWikilinks": { "type": "boolean" }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
